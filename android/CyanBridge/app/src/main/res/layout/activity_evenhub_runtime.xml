<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- URL input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/evenhub_url_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="EvenHub app URL"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/evenhub_load_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Load" />

        <Button
            android:id="@+id/evenhub_stop_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Stop" />

    </LinearLayout>

    <!-- WebView -->
    <WebView
        android:id="@+id/evenhub_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Debug log area -->
    <TextView
        android:id="@+id/evenhub_log"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#1a1a2e"
        android:gravity="bottom"
        android:padding="6dp"
        android:scrollbars="vertical"
        android:text="[EvenHub Runtime] Log started...\n"
        android:textColor="#e0e0e0"
        android:textSize="10sp"
        android:typeface="monospace" />

</LinearLayout>
