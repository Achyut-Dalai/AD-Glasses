<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <!-- Meeting capture banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/meeting_recording_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="#2A0808"
        app:strokeColor="#FF453A"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_meeting_banner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recording active"
                android:textColor="#FF453A"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_meeting_banner_stop"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop"
                app:strokeColor="#FF453A"
                android:textColor="#FF453A" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- HEADER: Status Dashboard -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0A0A0A"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/meeting_recording_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GLASSES STATUS"
                    android:textColor="#EDEDED"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"/>

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="32dp"
                    android:src="@null"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disconnected"
                        android:textColor="#888888"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/tv_device_class"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Class: Unknown"
                        android:textColor="#666666"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_status_metrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:layout_gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/layout_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Battery: "
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/battery_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textColor="#EDEDED"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_storage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Storage: "
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/storage_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#EDEDED"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Transfer progress (P2P sync) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_transfer_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#0A0A0A"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/card_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_transfer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYNC PROGRESS"
                android:textColor="#EDEDED"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tv_transfer_flow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Flow: --"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_transfer_counts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Photos: --  Videos: --  Audio: --"
                android:textColor="#EDEDED"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/progress_transfer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:progressTint="#EDEDED"
                android:max="100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_transfer_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Idle"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_transfer_stop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stop sync"
                    android:textAllCaps="false"
                    app:strokeColor="#333333"
                    android:textColor="#EDEDED" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        android:fadeScrollbars="false"
        app:layout_constraintTop_toBottomOf="@id/card_transfer_progress"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- SECTION: CONNECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTION"
                android:textColor="#666666"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_scan"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Scan"
                    android:backgroundTint="#EDEDED"
                    android:textColor="#000000"/>

                <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                <Button
                    android:id="@+id/btn_connect"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Reconnect"
                    app:strokeColor="#333333"
                    android:textColor="#EDEDED"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_disconnect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:text="Disconnect"
                app:strokeColor="#FF453A"
                android:textColor="#FF453A"/>

            <!-- SECTION: MEETING CAPTURE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEETING CAPTURE"
                android:textColor="#666666"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_meeting_start"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Start"
                    android:backgroundTint="#EDEDED"
                    android:textColor="#000000" />

                <Space android:layout_width="8dp" android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btn_meeting_stop"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Stop"
                    app:strokeColor="#333333"
                    android:textColor="#EDEDED" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#0A0A0A"
                android:padding="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Timer:"
                    android:textColor="#888888"
                    android:layout_gravity="center_vertical" />

                <Spinner
                    android:id="@+id/spinner_meeting_timer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_meeting_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Source: (not recording)"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <!-- SECTION: META RAYBAN CONTROLS -->
            <LinearLayout
                android:id="@+id/layout_meta_rayban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="META RAYBAN"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_meta_registration_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registration: Not registered"
                    android:textColor="#888888"
                    android:textSize="13sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_meta_register"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Register"
                        android:backgroundTint="#EDEDED"
                        android:textColor="#000000"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_meta_unregister"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Unregister"
                        app:strokeColor="#FF453A"
                        android:textColor="#FF453A"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_meta_session_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Session: Idle"
                    android:textColor="#888888"
                    android:textSize="13sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_meta_session_start"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Start Session"
                        android:backgroundTint="#EDEDED"
                        android:textColor="#000000"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_meta_session_stop"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Stop Session"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAMERA"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_meta_stream_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stream: Stopped"
                    android:textColor="#888888"
                    android:textSize="13sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_meta_stream_start"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Start Stream"
                        android:backgroundTint="#EDEDED"
                        android:textColor="#000000"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_meta_stream_stop"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Stop Stream"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_meta_capture_photo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Capture Photo"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_meta_view_photo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="View Last Photo"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"
                        android:enabled="false"/>
                </LinearLayout>

                 <!-- Display Controls (for Meta Ray-Ban Display) -->
                 <LinearLayout
                     android:id="@+id/layout_meta_display"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:orientation="vertical">

                     <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:text="DISPLAY"
                         android:textColor="#666666"
                         android:textSize="11sp"
                         android:letterSpacing="0.1"
                         android:layout_marginTop="24dp"
                         android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_meta_display_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Display: Inactive"
                    android:textColor="#888888"
                    android:textSize="13sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_meta_display_start"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Start Display"
                        android:backgroundTint="#EDEDED"
                        android:textColor="#000000"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_meta_display_stop"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Stop Display"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>
                 </LinearLayout>
             </LinearLayout>

            </LinearLayout>

            <!-- SECTION: HEY_CYAN EXTRAS -->
            <LinearLayout
                android:id="@+id/layout_ad_glasses_extras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI ASSISTANT"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cb_hijack_enabled"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Enable Hijack"
                        android:textColor="#EDEDED"
                        android:checked="true"
                        android:visibility="gone"
                        android:buttonTint="#EDEDED"/>

                    <CheckBox
                        android:id="@+id/cb_image_as_assistant"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Direct Assistant"
                        android:textColor="#EDEDED"
                        android:checked="true"
                        android:visibility="gone"
                        android:buttonTint="#EDEDED"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_mode_gemini"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Phone Assistant"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_mode_chatgpt"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Phone Assistant"
                        android:visibility="gone"
                        app:strokeColor="#333333"
                        android:textColor="#888888"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_mode_tasker"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Local / Tasker"
                        app:strokeColor="#333333"
                        android:textColor="#888888"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_test_hijack_voice"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Test Audio AI"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_test_hijack_image"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Test Vision AI"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MEDIA CONTROLS"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_camera"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="60dp"
                        android:text="Photo"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_video"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="60dp"
                        android:text="Video"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_record"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Audio"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_media_count"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="50dp"
                        android:text="Count"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_data_download"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Sync Data (P2P)"
                    app:strokeColor="#333333"
                    android:textColor="#EDEDED"
                    android:layout_marginTop="8dp"/>

                <!-- ADVANCED TOGGLE -->
                <Button
                    android:id="@+id/btn_toggle_advanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Advanced ▼"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="#666666"
                    android:layout_marginTop="24dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

                <!-- COLLAPSIBLE ADVANCED -->
                <LinearLayout
                    android:id="@+id/layout_advanced_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL AGENT"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_agent_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: Unknown"
                    android:textColor="#EDEDED"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tv_agent_last_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Last error: (none)"
                    android:textColor="#888888"
                    android:textSize="12sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btn_agent_start"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:text="Start"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_agent_stop"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:text="Stop"
                        app:strokeColor="#FF453A"
                        android:textColor="#FF453A"/>

                    <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                    <Button
                        android:id="@+id/btn_agent_demo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:text="Demo"
                        app:strokeColor="#333333"
                        android:textColor="#EDEDED"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE INFO"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <Button
                            android:id="@+id/btn_battery"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:text="Battery"
                            app:strokeColor="#333333"
                            android:textColor="#EDEDED"/>

                        <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                        <Button
                            android:id="@+id/btn_version"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:text="Version"
                            app:strokeColor="#333333"
                            android:textColor="#EDEDED"/>
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btn_set_time"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:text="Sync Time"
                            app:strokeColor="#333333"
                            android:textColor="#EDEDED"/>

                        <Space android:layout_width="8dp" android:layout_height="wrap_content"/>

                        <Button
                            android:id="@+id/btn_volume"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:text="Volume"
                            app:strokeColor="#333333"
                            android:textColor="#EDEDED"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEV TOOLS"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btn_add_listener"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_11"
                    android:textColor="#888888"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>

                <Button
                    android:id="@+id/btn_bt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_10"
                    android:textColor="#888888"
                    android:enabled="false"
                    android:alpha="0.5"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>

                <Button
                    android:id="@+id/btn_ota_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_16"
                    android:textColor="#888888"
                    android:enabled="false"
                    android:alpha="0.5"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>

                <Button
                    android:id="@+id/btn_pull_ota_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_17"
                    android:textColor="#888888"
                    android:enabled="false"
                    android:alpha="0.5"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#0A0A0A"
        app:itemIconTint="#EDEDED"
        app:itemTextColor="#EDEDED"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
