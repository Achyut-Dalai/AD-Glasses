<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ADGlasses" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ad_ink</item>
        <item name="colorAccent">@color/ad_red</item>
        <item name="android:colorAccent">@color/ad_red</item>

        <item name="android:windowBackground">@color/ad_background</item>
        <item name="android:colorBackground">@color/ad_background</item>
        <item name="android:textColorPrimary">@color/ad_ink</item>
        <item name="android:textColorSecondary">@color/ad_muted</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowSplashScreenBackground">@color/ad_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ad_surface</item>
        <item name="android:forceDarkAllowed">false</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Compatibility name retained only for inherited manifest/resource references. -->
    <style name="Theme.CyanBridgeManager" parent="Theme.ADGlasses" />

    <!-- Invisible hand-off used only by compatibility activity aliases. -->
    <style name="Theme.ADGlasses.Redirect" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
